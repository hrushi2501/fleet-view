{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/push/cron", "schedule": "0 3 * * *" },
    { "path": "/api/telematics/sync", "schedule": "* * * * *" }
  ]
}
