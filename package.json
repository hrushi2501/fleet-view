{
  "name": "fleetview-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "npm run deploy:check && npm run db:check && npm run build",
    "deploy:check": "node scripts/check-deployment.mjs",
    "test:deploy": "node --test scripts/deployment-env.test.mjs scripts/quality-gate.test.mjs scripts/rls-policy-contract.test.mjs scripts/run-sql-file.test.mjs scripts/hire-log-index-contract.test.mjs",
    "test:integration": "node --import ./scripts/test-setup.mjs --test tests/integration/*.test.ts",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "node --env-file=.env.local prisma/seed.mjs",
    "setup": "prisma generate && prisma db push && node --env-file=.env.local prisma/seed.mjs",
    "db:check": "prisma validate && node scripts/check-prisma-runtime.mjs",
    "db:deploy": "npm run db:check && npm run setup:production",
    "backup": "./scripts-backup.sh",
    "setup:production": "node --env-file=.env.local prisma/setup-production.mjs",
    "db:rls": "node --env-file=.env.local scripts/run-sql-file.mjs prisma/sql/enable-rls.sql && npm run db:rls:verify",
    "db:rls:verify": "node --env-file=.env.local scripts/run-sql-file.mjs prisma/sql/verify-rls.sql",
    "db:dedupe-hire-log-index": "node --env-file=.env.local scripts/run-sql-file.mjs prisma/sql/drop-redundant-hire-log-index.sql",
    "db:audit-index": "node --env-file=.env.local scripts/run-sql-file.mjs prisma/sql/security-schema-hardening.sql",
    "db:telemetry-index": "node --env-file=.env.local scripts/run-sql-file.mjs prisma/sql/telemetry-unique-index.sql",
    "db:migrate-passwords": "node --env-file=.env.local scripts/migrate-legacy-passwords.mjs",
    "test": "node --import ./scripts/test-setup.mjs --test \"src/**/*.test.ts\"",
    "test:all": "npm test && npm run test:deploy",
    "test:mutation": "node scripts/mutation-test.mjs",
    "check": "npm run lint && tsc --noEmit && npm run test:all",
    "verify": "npm run check && npm run build",
    "verify:integration": "npm run verify && npm run test:integration",
    "verify:release": "npm run verify:integration && npm run db:check",
    "worker:telematics": "node --env-file=.env.local --import ./scripts/test-setup.mjs scripts/telematics-worker.mjs",
    "worker:telematics:once": "node --env-file=.env.local --import ./scripts/test-setup.mjs scripts/telematics-worker.mjs --once",
    "db:clean-and-sync": "node --env-file=.env.local --import ./scripts/test-setup.mjs scripts/clean-and-sync-tata.mjs",
    "db:remove-site-tanks": "node --env-file=.env.local prisma/remove-site-tanks.mjs",
    "audit:confidence": "node --env-file=.env.local --import ./scripts/test-setup.mjs scripts/confidence-audit.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.208",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.18.0",
    "next": "16.3.3",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.0",
    "uuid": "^11.1.0"
  }
}
