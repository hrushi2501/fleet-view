# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and is the one file a new developer
# needs in order to know what to ask for. The broad rule above hides it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# database backups (client data — keep out of git)
/backups

# stale SQLite db from the pre-Postgres trial (app now uses Neon/Postgres)
prisma/*.db

# issued credentials — never commit, hand these over directly
CREDENTIALS.local.json
DRIVER-CREDENTIALS.local.json

# supabase connection string — never commit
.supabase-url
.supabase-pooled
.supabase-direct

.env.local.neon-backup

# Claude Code local state — agent settings and memory, not project source.
.claude/settings.local.json
.claude/projects/

# Superdesign local context and resume state — generated design-work metadata.
.superdesign/
