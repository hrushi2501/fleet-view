# Copy to .env.local and fill in. `.env*` is gitignored — never commit real values.
# Ask whoever set the project up for these; several are client credentials.
# Vercel setup: docs/VERCEL-DEPLOYMENT.md. No Docker or separate worker required.

# --- Database (required — nothing runs without it) -------------------------
# Supabase pooled connection. Keep the query string: pgbouncer=true disables
# prepared statements the pooler cannot handle. The runtime raises the pool to
# three in production and five locally so independent page reads can overlap.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=3
# Explicit per-instance override. Keep this small on serverless deployments;
# three is the measured default for this application's parallel page reads.
PRISMA_CONNECTION_LIMIT=
# Privileged operator connection, used for migrations. Not needed on Vercel.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/postgres
# Table-owner connection for one-off RLS policy DDL only. Do not add this to
# Vercel runtime variables; use it locally or run the SQL in Supabase Dashboard.
DATABASE_URL_OWNER=
# Optional alternative to DATABASE_URL_OWNER when DATABASE_URL identifies the
# Supabase project. Used only to construct a one-off postgres owner connection.
SUPABASE_DB_PASSWORD=

# --- Authentication (required in production) --------------------------------
# Generate once with `openssl rand -base64 48`; do not derive this from a
# database URL or reuse it in another service. Rotating it signs every browser
# out, which is expected after a suspected secret exposure.
AUTH_SECRET=
# Required only for `npm run seed`; never commit a demo credential.
DEMO_ADMIN_PASSWORD=
DEMO_SECONDARY_ADMIN_PASSWORD=

# --- Tata Fleet Edge (vehicle tracking + fuel analysis) --------------------
TATA_FLEET_EDGE_ENABLED=false
TATA_FLEET_EDGE_CLIENT_ID=
TATA_FLEET_EDGE_CLIENT_SECRET=
TATA_FLEET_EDGE_TOKEN_URL=https://cvp.api.tatamotors/auth/realms/external/protocol/openid-connect/token
TATA_FLEET_EDGE_BASE_URL=https://cvp.api.tatamotors
TATA_FLEET_EDGE_POSITIONS_PATH=api/vehicle-snapshots
# Fleet Edge cannot sign requests or send an Authorization header. Generate a
# 32-byte random token and register the exact URL below with Tata:
#   https://YOUR_HOST/api/telematics/tata?token=THE_VALUE
# Redact `token` in edge/access logs. This is preferred to source-IP alone.
TATA_PUSH_URL_TOKEN=
# Used only if no URL token is configured. The default is Tata's published
# egress IP; override only after Tata confirms a change.
# TATA_PUSH_ALLOWED_IPS=3.6.12.131
# Required only when self-hosting behind a reverse proxy that strips and
# replaces X-Forwarded-For. Vercel is detected automatically.
TATA_PUSH_TRUSTED_PROXY=false
# Local diagnosis only. Production rejects this setting rather than opening the
# receiver to the internet.
TATA_PUSH_TRUST_ANY=false

# --- Shared secrets --------------------------------------------------------
# Device/webhook telemetry push. No default: unset means the endpoint refuses
# every request rather than falling back to a key anyone could read.
FLEET_INGEST_KEY=
# Separate random secret, at least 32 bytes; Vercel Cron sends it automatically.
CRON_SECRET=

# --- Photo reading (odometer / pump / gauge) -------------------------------
# Google AI Studio key, free tier, no card: https://aistudio.google.com/apikey
# Without it the driver wizard falls back to manual entry and says so plainly —
# it does not tell the driver their photo is unclear.
GOOGLE_GENERATIVE_AI_API_KEY=
# Override only if Google retires the current model id.
# GEMINI_MODEL=gemini-3-flash-preview

# --- Evidence and document storage ------------------------------------------
# Created automatically when a private Vercel Blob store is connected to the
# project. Required for fuel photos, licences, compliance scans, and receipts.
BLOB_READ_WRITE_TOKEN=

# --- Optional --------------------------------------------------------------
# The timezone the business works in. Every day/month boundary resolves through
# it, because the server runs UTC and the client works in IST.
BUSINESS_TIMEZONE=Asia/Kolkata
# Denominator for hire utilisation. A commercial assumption, not a fact.
WORKING_HOURS_PER_DAY=8
# Verbose per-vehicle trace of how each fuel figure was reached.
FUEL_ANALYSIS_DEBUG=false

# --- Optional security monitoring -------------------------------------------
# HTTPS receiver for DENIED and LOGIN_FAILED audit events (SIEM/Slack bridge).
# It receives audit metadata, so use an approved private endpoint. Delivery is
# best-effort; keep a receiver-side heartbeat/failed-delivery alert as well.
SECURITY_AUDIT_WEBHOOK_URL=

# --- Optional web push -------------------------------------------------------
# Rotate VAPID keys only through the documented procedure: rotation invalidates
# every existing browser subscription and requires users to resubscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
